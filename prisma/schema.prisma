// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  phone        String
  imageUrl     String
  role         Role             @relation(fields: [roleId], references: [id]) //Relacion con rol
  roleId       Int //Dato para hacer la relacion
  leads        Lead[] // Relación Uno a Muchos con Lead
  permissions  UserPermission[]
  Comment      Comment[]
  createdAt    DateTime         @default(now())
  udpatedAt    DateTime         @updatedAt
  UserActivity UserActivity[]
}

model Permission {
  id                Int               @id @default(autoincrement())
  name              String
  description       String
  action            Action
  active            Boolean
  serviceAssociated ServiceAssociated
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  RolePermission    RolePermission[]
  UserPermission    UserPermission[]
}

model Project {
  id               Int          @id @default(autoincrement())
  name             String
  description      String
  expectedDuration String
  startDate        String
  endDate          String
  estimate_id      Int?
  estimate         Estimate?    @relation(fields: [estimate_id], references: [id], onDelete: Cascade)
  currentPhase     CurrentPhase
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  Phase            Phase[]
}

model Estimate {
  id            Int           @id @default(autoincrement())
  estimatedTime String
  description   String
  state         EstimateState
  lead_id       Int?
  lead          Lead?         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  totalValue    Decimal
  Project       Project[]
  costs         Cost[]
  comments      Comment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Blog {
  id              Int      @id @default(autoincrement())
  title           String
  resume          String
  content         String
  topic           Topic
  publicationDate String
  imageUrl        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ServiceArea {
  id               Int       @id @default(autoincrement())
  name             String
  description      String
  active           Boolean
  county           County
  heroImageUrl     String
  benefitsImageUrl String
  testimonialEmbed String
  service_id       Int?
  service          Service?  @relation(fields: [service_id], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  Benefit          Benefit[]
}

model Service {
  id          Int           @id @default(autoincrement())
  name        String
  description String
  active      Boolean
  ServiceArea ServiceArea[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum County {
  MIAMI_DATE
  BROWARD
  WEST_PALM_BEACH
}

enum Topic {
  WEBDESIGN
  DIGITALMARKETING
  GRAPHICDESIGN
}

enum Action {
  GET
  CREATE
  UPDATE
  DELETE
}

enum ServiceAssociated {
  NORMALUSERS
  ADMINUSERS
  LEADS
  ESTIMATES
  PROJECTS
  BLOGS
  PRODUCTS
  SERVICEAREAS
}

enum CurrentPhase {
  ANALYSIS
  DESIGN
  DEVELOPMENT
  DEPLOY
}

enum EstimateState {
  CREATED
  PROCESSING
  INREVIEW
  REJECTED
  ACCEPTED
  INVOICE
  PAID
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String
  description String
  user        User[] //Aqui nos referimos que este puede tener multiples usuarios 
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId]) // Clave primaria compuesta
}

model Lead {
  id          Int        @id @default(autoincrement())
  clientName  String?
  clientEmail String?
  clientPhone String?
  name        String
  description String
  state       LeadState
  starDate    String
  endDate     String
  userId      Int? // Clave foránea
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Estimate    Estimate[]
}

enum LeadState {
  SEND
  PROCESSING
  ESTIMATING
  FINISHED
}

model UserPermission {
  userId       Int
  permissionId Int

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId]) // Clave primaria compuesta
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  url         String
}

model Phase {
  id               Int        @id @default(autoincrement())
  name             PhaseName
  description      String
  expectedDuration String
  startDate        String
  endDate          String
  project_id       Int?
  project          Project?   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  state            PhaseState
  Comment          Comment[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  Activity         Activity[]
}

enum PhaseName {
  ANALYSIS
  DESIGN
  DEVELOPMENT
  DEPLOY
}

enum PhaseState {
  PLANNING
  INPROCESS
  TESTING
  FINISHED
}

model Activity {
  id               Int            @id @default(autoincrement())
  name             String
  description      String
  expectedDuration String
  startDate        String
  endDate          String
  phase_id         Int?
  phase            Phase?         @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  state            StateActivity
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  UserActivity     UserActivity[]
  Attachment       Attachment[]
}

enum StateActivity {
  PENDING
  ASSIGNED
  INPROCESS
  REVIEWING
  FINISHED
}

model UserActivity {
  user_id     Int
  activity_id Int
  user        User     @relation(fields: [user_id], references: [id])
  activity    Activity @relation(fields: [activity_id], references: [id])

  @@id([user_id, activity_id])
}

model Cost {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  type        CostType
  value       Float
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  estimateId  Int
  createdAt   DateTime @default(now())
  udpatedAt   DateTime @updatedAt
}

enum CostType {
  MANPOWER
  TECHNOLOGIES
  LICENSE
  OTHERS
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  sendData   String
  sendTime   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  estimateId Int
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  phaseId    Int
  phase      Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  udpatedAt  DateTime @updatedAt
}

model Attachment {
  id          Int            @id @default(autoincrement())
  name        String
  description String
  type        TypeAttachment
  url         String
  activityId  Int?
  activity    Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  ticketId    Int?
  ticket      Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Ticket {
  id Int @id @default(autoincrement())

  Attachment Attachment[]
}

model Benefit {
  id            Int          @id @default(autoincrement())
  title         String
  description   String
  serviceAreaId Int?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
}

enum TypeAttachment {
  IMAGE
  DOCUMENT
  URL
  VIDEO
  OTHERS
}
