// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String
  imageUrl  String
  createdAt DateTime @default(now())
  udpatedAt DateTime @updatedAt
}

model Permission {
  id                Int               @id @default(autoincrement())
  name              String
  description       String
  action            Action
  active            Boolean
  serviceAssociated ServiceAssociated
  createdAt         DateTime          @default(now())
  udpatedAt         DateTime          @updatedAt
}

model Project {
  id               Int          @id @default(autoincrement())
  name             String
  description      String
  expectedDuration String
  startDate        String
  endDate          String
  estimate_id      Int
  estimate         Estimate     @relation(fields: [estimate_id], references: [id])
  currentPhase     CurrentPhase
  createdAt        DateTime     @default(now())
  udpatedAt        DateTime     @updatedAt
}

model Estimate {
  id            Int       @id @default(autoincrement())
  estimatedTime String
  description   String
  state         State
  lead_id       Int
  lead          Lead      @relation(fields: [lead_id], references: [id])
  totalValue    Decimal
  Project       Project[]
  createdAt     DateTime  @default(now())
  udpatedAt     DateTime  @updatedAt
}

model Lead {
  id          Int           @id @default(autoincrement())
  Estimate    Estimate[]
  createdAt   DateTime      @default(now())
  udpatedAt   DateTime      @updatedAt
  ServiceArea ServiceArea[]
}

model Blog {
  id              Int      @id @default(autoincrement())
  title           String
  resume          String
  content         String
  topic           Topic
  publicationDate String
  imageUrl        String
  createdAt       DateTime @default(now())
  udpatedAt       DateTime @updatedAt
}

model ServiceArea {
  id               Int      @id @default(autoincrement())
  name             String
  description      String
  active           Boolean
  county           County
  heroImageUrl     String
  benefitsImageUrl String
  testimonialEmbed String
  service_id       Int
  service          Lead     @relation(fields: [service_id], references: [id])
  createdAt        DateTime @default(now())
  udpatedAt        DateTime @updatedAt
}

model Service {
  id Int @id @default(autoincrement())
}

enum County {
  MIAMI_DATE
  BROWARD
  WEST_PALM_BEACH
}

enum Topic {
  SINDEFINIR
}

enum Action {
  GET
  CREATE
  UPDATE
  DELETE
}

enum ServiceAssociated {
  NORMALUSERS
  ADMINUSERS
  LEADS
  ESTIMATES
  PROJECTS
  BLOGS
  PRODUCTS
  SERVICEAREAS
}

enum CurrentPhase {
  ANALYSIS
  DESIGN
  DEVELOPMENT
  DEPLOY
}

enum State {
  CREATED
  PROCESSING
  INREVIEW
  REJECTED
  ACCEPTED
  INVOICE
  PAID
}
