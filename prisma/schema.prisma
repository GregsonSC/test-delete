generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  phone        String
  imageUrl     String?
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  phone        String
  imageUrl     String?
  createdAt    DateTime         @default(now())
  roleId       Int
  roleId       Int
  updatedAt    DateTime         @updatedAt
  address      String
  blogs        Blog[]
  Comment      Comment[]
  contracts    Contract[]
  leads        Lead[]
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  address      String
  blogs        Blog[]
  Comment      Comment[]
  contracts    Contract[]
  leads        Lead[]
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  UserActivity UserActivity[]
  permissions  UserPermission[]
  tickets      UserTicket[]
  permissions  UserPermission[]
  tickets      UserTicket[]
  UserWorkTeam UserWorkTeam[]
}

model Permission {
  id                Int               @id @default(autoincrement())
  name              String
  description       String?
  description       String?
  action            Action
  active            Boolean
  serviceAssociated ServiceAssociated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  RolePermission RolePermission[]
  UserPermission UserPermission[]
}

model Project {
  id               Int     @id @default(autoincrement())
  name             String
  description      String
  expectedDuration String
  startDate        String
  endDate          String?
  estimate_id      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  imagePreviewUrl  String?
  Phase            Phase[]
  estimate         Estimate? @relation(fields: [estimate_id], references: [id], onDelete: Cascade)
  endDate          String?
  imagePreviewUrl  String?

  estimate_id Int?
  estimate    Estimate? @relation(fields: [estimate_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Phase     Phase[]
}

model Estimate {
  id                 Int           @id @default(autoincrement())
  estimatedTime      String?
  description        String?
  state              EstimateState
  lead_id            Int
  lead               Lead          @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  plan_id            Int?
  plan               Plan?         @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  totalValue         Decimal?
  deadLineToPay      String?
  invoiceDateCreated String?
  invoiceReference   String?

  Project  Project[]
  costs    Cost[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id              Int     @id @default(autoincrement())
  title           String
  resume          String
  topic           Topic
  publicationDate String
  imageUrl        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ContentImageUrl String?
  ImageReference  String?
  ImageSubTitle   String?
  SubTitle        String
  userId          Int
  content         Json
  User            User     @relation(fields: [userId], references: [id])
  SubTitle        String
  ImageSubTitle   String?
  ContentImageUrl String?
  ImageReference  String?
  userId          Int
  User            User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceArea {
  id               Int     @id @default(autoincrement())
  name             String
  description      String
  active           Boolean
  county           County
  heroImageUrl     String
  benefitsImageUrl String
  testimonialEmbed String
  mainTitle        String
  subTitle         String

  service_id Int
  service    Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Benefit   Benefit[]
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  active      Boolean

  ServiceArea ServiceArea[]
  plans       Plan[]
  leads       Lead[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Product     Product[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  active      Boolean
  permissions RolePermission[]
  user        User[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Lead {
  id Int @id @default(autoincrement())

  clientName    String?
  clientEmail   String?
  clientPhone   String?
  clientAddress String?
  state         LeadState
  startDate     String
  endDate       String?
  description   String

  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId  Int
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  workTeamId Int?
  WorkTeam   WorkTeam? @relation(fields: [workTeamId], references: [id])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Estimate  Estimate[]
  contracts Contract[]
}

model UserPermission {
  userId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@id([userId, permissionId])
}

model Product {
  id Int @id @default(autoincrement())

  name        String
  description String
  imageUrl    String
  siteUrl     String
  
  serviceId   Int
  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  Attachment  Attachment[]
  ProductTag ProductTag[]
}

model Phase {
  id Int @id @default(autoincrement())

  name             PhaseName
  description      String?
  expectedDuration String
  startDate        String
  endDate          String?
  state            PhaseState
  project_id       Int
  project          Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)

  Comment       Comment[]
  Activity      Activity[]
  ProjectUpdate ProjectUpdate[]
  updatedAt     DateTime        @updatedAt
  createdAt     DateTime        @default(now())
}

model Activity {
  id               Int           @id @default(autoincrement())
  name             String
  description      String?
  expectedDuration String?
  startDate        String
  endDate          String?
  state            StateActivity
  priority         Priority?

  phase_id Int
  phase    Phase @relation(fields: [phase_id], references: [id], onDelete: Cascade)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  UserActivity UserActivity[]
  Attachment   Attachment[]
}

model UserActivity {
  user_id     Int
  activity_id Int
  activity    Activity @relation(fields: [activity_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])

  @@id([user_id, activity_id])
}

model Cost {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  type        CostType
  value       Float
  estimateId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

model Comment {
  id         Int       @id @default(autoincrement())
  content    String
  sendDate   String
  sendTime   String
  userId     Int
  estimateId Int?
  phaseId    Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  estimate   Estimate? @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  phase      Phase?    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  type        PlanType
  serviceId   Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Estimate    Estimate[]
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  variants    Variant[]
}

model Variant {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  benefits    String
  price       Float
  planId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model UserTicket {
  userId   Int
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ticketId])
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String
  type        TicketPlan
  description String?
  status      TicketStatus
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Attachment  Attachment[]
  users       UserTicket[]
}

model Attachment {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  type        TypeAttachment
  url         String

  activityId       Int?
  activity         Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  ticketId         Int?
  ticket           Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productId        Int?
  product          Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  projectupdate_id Int?
  projectupdate    ProjectUpdate? @relation(fields: [projectupdate_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Benefit {
  id            Int         @id @default(autoincrement())
  title         String
  description   String
  serviceAreaId Int
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkTeam {
  id Int @id @default(autoincrement())

  name        String
  description String?
  state       StateWorkTeam
  area        AreaWorkTeam

  leads        Lead[]
  UserWorkTeam UserWorkTeam[]
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())
}

model UserWorkTeam {
  user_id     Int
  workTeam_id Int
  user        User     @relation(fields: [user_id], references: [id])
  workTeam    WorkTeam @relation(fields: [workTeam_id], references: [id])

  @@id([user_id, workTeam_id])
}

model StudyCase {
  id       Int    @id @default(autoincrement())
  title    String
  resume   String
  videoUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectUpdate {
  id      Int    @id @default(autoincrement())
  title   String
  content String
  date    String

  phaseId Int
  phase   Phase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Attachment Attachment[]
}

model Tag {
  id   Int     @id @default(autoincrement())
  name String

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  ProductTag ProductTag[]
}

model ProductTag {
  product_id Int
  tag_id     Int
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tag        Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([product_id, tag_id])
}

model LoginAttempt {
  id          String   @id @default(uuid())
  ip          String
  email       String?
  success     Boolean
  attemptedAt DateTime @default(now())
}

model Clause {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  clauses     ContractClause[]
}

model Contract {
  id                Int              @id @default(autoincrement())
  title             String
  signedDate        String
  companyEmail      String
  companyAdd        String
  companyPhone      String
  content           String
  ownerName         String
  ownerSignDate     String?
  recipientName     String
  recipientSignDate String?
  userId            Int
  leadId            Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lead              Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clauses           ContractClause[]
}

model ContractClause {
  contractId Int
  clauseId   Int
  clause     Clause   @relation(fields: [clauseId], references: [id])
  contract   Contract @relation(fields: [contractId], references: [id])

  @@id([contractId, clauseId])
}

enum County {
  MIAMI_DATE
  BROWARD
  WEST_PALM_BEACH
}

enum Topic {
  WEBDESIGN
  DIGITALMARKETING
}

enum Action {
  GET
  CREATE
  UPDATE
  DELETE
}

enum ServiceAssociated {
  NORMALUSERS
  ADMINUSERS
  LEADS
  ESTIMATES
  PROJECTS
  BLOGS
  PRODUCTS
  SERVICEAREAS
}

enum EstimateState {
  CREATED
  PROCESSING
  INREVIEW
  REJECTED
  ACCEPTED
  INVOICE
  PAID
}

enum LeadState {
  SEND
  PROCESSING
  ESTIMATING
  FINISHED
}

enum PhaseName {
  ANALYSIS
  DESIGN
  DEVELOPMENT
  DEPLOY
}

enum PhaseState {
  PLANNING
  INPROCESS
  TESTING
  FINISHED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StateActivity {
  PENDING
  ASSIGNED
  INPROCESS
  REVIEWING
  FINISHED
}

enum CostType {
  MANPOWER
  TECHNOLOGIES
  LICENSE
  OTHERS
}

enum PlanType {
  MONTHLY
  SINGLEPAYMENT
}

enum TicketPlan {
  BUG
  REQUEST
  REVIEW
  OTHER
}

enum TicketStatus {
  PENDING
  ASSIGNED
  INPROCESS
  UNDERREVIEW
  SOLVED
  CLOSED
}

enum TypeAttachment {
  IMAGE
  DOCUMENT
  URL
  VIDEO
  OTHERS
}

enum StateWorkTeam {
  AVAILABLE
  INACTIVE
  ASSIGNED
}

enum AreaWorkTeam {
  BACKEND
  FRONTEND
  DESIGN
  MANAGEMENT
  ADMINISTRATIVE
  MARKETING
  SALES
  DEVOPS
  SUPPORT
}
