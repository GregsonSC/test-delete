// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  phone        String
  imageUrl     String
  role         Role             @relation(fields: [roleId], references: [id]) //Relacion con rol
  roleId       Int //Dato para hacer la relacion
  leads        Lead[] // Relación Uno a Muchos con Lead
  permissions  UserPermission[]
  Comment      Comment[]
  tickets      UserTicket[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  UserActivity UserActivity[]
  UserWorkTeam UserWorkTeam[]
}

model Permission {
  id                Int               @id @default(autoincrement())
  name              String
  description       String
  action            Action
  active            Boolean
  serviceAssociated ServiceAssociated
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  RolePermission    RolePermission[]
  UserPermission    UserPermission[]
}

model Project {
  id               Int             @id @default(autoincrement())
  name             String
  description      String
  expectedDuration String
  startDate        String
  endDate          String
  estimate_id      Int?
  estimate         Estimate?       @relation(fields: [estimate_id], references: [id], onDelete: Cascade)
  currentPhase     CurrentPhase
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  imagePreviewUrl  String
  Phase            Phase[]
  ProjectUpdate    ProjectUpdate[]
}

model Estimate {
  id            Int           @id @default(autoincrement())
  estimatedTime String
  description   String
  state         EstimateState
  lead_id       Int?
  lead          Lead?         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  totalValue    Decimal
  Project       Project[]
  costs         Cost[]
  comments      Comment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Blog {
  id              Int      @id @default(autoincrement())
  title           String
  resume          String
  content         String
  topic           Topic
  publicationDate String
  imageUrl        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ServiceArea {
  id               Int       @id @default(autoincrement())
  name             String
  description      String
  active           Boolean
  county           County
  heroImageUrl     String
  benefitsImageUrl String
  testimonialEmbed String
  service_id       Int?
  service          Service?  @relation(fields: [service_id], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  Benefit          Benefit[]
}

model Service {
  id          Int           @id @default(autoincrement())
  name        String
  description String
  active      Boolean
  ServiceArea ServiceArea[]
  plans       Plan[]
  leads       Lead[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum County {
  MIAMI_DATE
  BROWARD
  WEST_PALM_BEACH
}

enum Topic {
  WEBDESIGN
  DIGITALMARKETING
}

enum Action {
  GET
  CREATE
  UPDATE
  DELETE
}

enum ServiceAssociated {
  NORMALUSERS
  ADMINUSERS
  LEADS
  ESTIMATES
  PROJECTS
  BLOGS
  PRODUCTS
  SERVICEAREAS
}

enum CurrentPhase {
  ANALYSIS
  DESIGN
  DEVELOPMENT
  DEPLOY
}

enum EstimateState {
  CREATED
  PROCESSING
  INREVIEW
  REJECTED
  ACCEPTED
  INVOICE
  PAID
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String
  description String
  user        User[] //Aqui nos referimos que este puede tener multiples usuarios 
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId]) // Clave primaria compuesta
}

model Lead {
  id          Int        @id @default(autoincrement())
  clientName  String?
  clientEmail String?
  clientPhone String?
  name        String
  description String
  state       LeadState
  startDate   String
  endDate     String
  userId      Int? // Clave foránea
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId   Int?
  service     Service?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Estimate    Estimate[]
}

enum LeadState {
  SEND
  PROCESSING
  ESTIMATING
  FINISHED
}

model UserPermission {
  userId       Int
  permissionId Int

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([userId, permissionId]) // Clave primaria compuesta
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  url         String
  Attachment  Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

}

model Phase {
  id               Int             @id @default(autoincrement())
  name             PhaseName
  description      String
  expectedDuration String
  startDate        String
  endDate          String
  project_id       Int?
  project          Project?        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  state            PhaseState
  Comment          Comment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  Activity         Activity[]
  ProjectUpdate    ProjectUpdate[]
}

enum PhaseName {
  ANALYSIS
  DESIGN
  DEVELOPMENT
  DEPLOY
}

enum PhaseState {
  PLANNING
  INPROCESS
  TESTING
  FINISHED
}

model Activity {
  id               Int            @id @default(autoincrement())
  name             String
  description      String
  expectedDuration String
  startDate        String
  endDate          String
  phase_id         Int?
  phase            Phase?         @relation(fields: [phase_id], references: [id], onDelete: Cascade)
  state            StateActivity
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  UserActivity     UserActivity[]
  Attachment       Attachment[]
}

enum StateActivity {
  PENDING
  ASSIGNED
  INPROCESS
  REVIEWING
  FINISHED
}

model UserActivity {
  user_id     Int
  activity_id Int
  user        User     @relation(fields: [user_id], references: [id])
  activity    Activity @relation(fields: [activity_id], references: [id])

  @@id([user_id, activity_id])
}

model Cost {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  type        CostType
  value       Float
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  estimateId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CostType {
  MANPOWER
  TECHNOLOGIES
  LICENSE
  OTHERS
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  sendDate   String
  sendTime   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  estimateId Int
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  phaseId    Int
  phase      Phase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Plan {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  type        PlanType
  variants    Variant[] // Relación uno-a-muchos con Variant
  serviceId   Int
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Variant {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  benefits    String
  price       Float
  planId      Int
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade) // Relación con Plan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PlanType {
  MONTHLY
  SINGLEPAYMENT
}

model UserTicket {
  userId   Int
  ticketId Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([userId, ticketId])
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String
  type        TicketPlan
  description String
  status      TicketStatus
  users       UserTicket[]
  Attachment  Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum TicketPlan {
  BUG
  REQUEST
  REVIEW
  OTHER
}

enum TicketStatus {
  PENDING
  ASSIGNED
  INPROCESS
  UNDERREVIEW
  SOLVED
  CLOSED
}

model Attachment {
  id          Int            @id @default(autoincrement())
  name        String
  description String
  type        TypeAttachment
  url         String
  activityId  Int?
  activity    Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  ticketId    Int?
  ticket      Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Benefit {
  id            Int          @id @default(autoincrement())
  title         String
  description   String
  serviceAreaId Int?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TypeAttachment {
  IMAGE
  DOCUMENT
  URL
  VIDEO
  OTHERS
}

model WorkTeam {
  id           Int            @id @default(autoincrement())
  name         String
  description  String
  state        StateWorkTeam
  area         AreaWorkTeam
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  UserWorkTeam UserWorkTeam[]
}

enum StateWorkTeam {
  AVAILABLE
  INACTIVE
  ASSIGNED
}

enum AreaWorkTeam {
  BACKEND
  FRONTEND
  DESIGN
  MANAGEMENT
  ADMINISTRATIVE
  MARKETING
  SALES
  DEVOPS
  SUPPORT
}

model UserWorkTeam {
  user_id     Int
  workTeam_id Int
  user        User     @relation(fields: [user_id], references: [id])
  workTeam    WorkTeam @relation(fields: [workTeam_id], references: [id])

  @@id([user_id, workTeam_id])
}

model StudyCase {
  id        Int      @id @default(autoincrement())
  title     String
  resume    String
  videoUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectUpdate {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  date      String
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId   Int?
  phase     Phase?   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
